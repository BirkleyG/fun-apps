rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId}/apps/{appId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /time-loop-cyoa/{docId} {
      allow read, write: if docId == "story";
    }

    match /time-loop-cyoa-nodes/{nodeId} {
      allow read, write: if true;
    }

    match /emoji-battle-lobbies/{lobbyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host.uid == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.host.uid == request.auth.uid
          || (resource.data.guest != null && resource.data.guest.uid == request.auth.uid)
          || (resource.data.guest == null && request.resource.data.guest.uid == request.auth.uid)
        );
      allow delete: if signedIn() && resource.data.host.uid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.sender.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
